# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# 本番のみ: スキーム付きで列挙（例: https://bonsai.example.com）
CSRF_TRUSTED_ORIGINS=
# 本番のみ: Sentry の environment タグ / ログレベル / gunicorn のワーカー数
DJANGO_ENV=production
DJANGO_LOG_LEVEL=INFO
WEB_CONCURRENCY=2

# Database (dev: docker-compose / prod: Supabase)
DATABASE_URL=postgres://bonsai:bonsai@localhost:5432/bonsai

# Storage (dev: local MEDIA_ROOT / prod: Supabase Storage S3 互換)
USE_S3_STORAGE=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=

# Google OAuth (django-allauth)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Sentry (prod のみ)
SENTRY_DSN=

# Email（パスワード再設定・メール確認に必須。Resend / SendGrid 等の SMTP）
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com

{
  "name": "bonsai-management-frontend",
  "private": true,
  "description": "Tailwind CSS のビルドと、Alpine.js / htmx の静的配信用コピー（Django から {% static %} で配信）",
  "scripts": {
    "build": "npm run build:css && npm run build:js",
    "build:css": "tailwindcss -c tailwind.config.js -i static/css/src/input.css -o static/css/tailwind.css --minify",
    "build:js": "node tools/copy_vendor_js.mjs",
    "watch:css": "tailwindcss -c tailwind.config.js -i static/css/src/input.css -o static/css/tailwind.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "alpinejs": "^3.14.9",
    "htmx.org": "2.0.4",
    "tailwindcss": "^3.4.17"
  }
}
